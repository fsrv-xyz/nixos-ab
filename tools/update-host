#!/usr/bin/env bash
# update-host [--reboot | --switch] <ssh target> [update]: installs an update (default ./result,
# or the update/ of a release) on a running host with ab-update, served over the SSH connection
set -euo pipefail

fail() {
  echo "update-host: $*" >&2
  exit 1
}
usage() {
  echo "usage: update-host [--reboot | --switch] ssh-target [update]" >&2
  exit 2
}
reboot='' switch=''
while [[ ${1-} == --* ]]; do
  case $1 in
  --reboot) reboot=1 ;;
  --switch) switch=1 ;;
  *) usage ;;
  esac
  shift
done
[[ -z $reboot || -z $switch ]] || usage
(($# == 1 || $# == 2)) || usage
target=$1 update=${2:-result}
[[ ! -e $update/update ]] || update=$update/update
[[ -e $update/SHA256SUMS ]] || fail "$update holds no update: nix build .#<name>.update"
(cd "$update" && sha256sum --check --quiet --strict SHA256SUMS) || fail "$update does not match its SHA256SUMS"
usrhash=$(<"$update/usrhash")

if [[ -n $switch ]]; then
  # before the update is installed: a reboot would start it, switched to or not
  help=$(ssh -n "$target" 'ab-update -h 2>&1 || :') || fail "$target: no answer"
  [[ $help == *-confirm* ]] || fail "$target: its ab-update knows no -confirm, update it with --reboot first"
fi

tmp=$(mktemp -d)
trap 'rm -r "$tmp"' EXIT
# port 0: a free port, so no other server on 127.0.0.1 can answer ab-update
port=$(darkhttpd "$update" --addr 127.0.0.1 --port 0 --daemon --pidfile "$tmp/server" --log /dev/null |
  sed -n 's|^listening on: http://127.0.0.1:\([0-9]*\)/$|\1|p')
trap 'kill "$(<"$tmp/server")"; rm -r "$tmp"' EXIT
ssh -o ExitOnForwardFailure=yes -R "$port:127.0.0.1:$port" "$target" ab-update "http://127.0.0.1:$port/"
[[ -n $reboot || -n $switch ]] || exit 0

# booted is the image of the kernel, live the one the system runs: they differ after a switch
probe='booted=$(sed -n "s/.*usrhash=\([0-9a-f]*\).*/\1/p" /proc/cmdline); echo "$(</proc/sys/kernel/random/boot_id)" \
  "$booted" "$(cat /run/ab-update/live 2>/dev/null || echo "$booted")" \
  "$(/run/current-system/systemd/lib/systemd/systemd-bless-boot status)" \
  "$(bootctl status 2>/dev/null | sed -n "s/^ *Current Entry: //p")"'
read -r previous booted live _ < <(ssh -n "$target" "$probe") || fail "$target: no answer"

if [[ -n $switch ]]; then
  # in the background: the switch waits for the confirmation below, and may cut this connection
  ssh -n -o ServerAliveInterval=10 "$target" ab-update -confirm switch &
  switching=$!
  trap 'kill "$switching" 2>/dev/null || :; kill "$(<"$tmp/server")"; rm -r "$tmp"' EXIT
  deadline=$((SECONDS + 1200))
  while :; do
    # whether the switch waits, then the unit: once that is gone, the image read after it is the final one
    if { read -r waits && read -r state && read -r id _ live _; } < <(ssh -n -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=10 \
      "$target" "test -p /run/ab-update/confirm; echo \$?; systemctl is-active ab-update-switch.service; $probe" 2>"$tmp/ssh"); then
      [[ $id == "$previous" ]] || fail "$target rebooted instead of switching"
      # a login opened now that the switch waits, and not multiplexed: one from before the activation shows nothing
      [[ $waits != 0 ]] || ssh -n -o ControlPath=none -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=10 "$target" ab-update confirm 2>/dev/null || :
      case $state in
      active | activating) ;;
      *)
        # the unit is inactive before the switch starts too: final once its connection has ended
        if ! kill -0 "$switching" 2>/dev/null; then
          [[ $live == "$usrhash" ]] || fail "$target did not switch to this image"
          echo "update-host: $target runs this image, without a reboot"
          exit 0
        fi
        ;;
      esac
    fi
    if ((SECONDS >= deadline)); then
      cat "$tmp/ssh" >&2
      fail "$target: no answer for 20 minutes"
    fi
    sleep 5
  done
fi

if [[ $booted == "$usrhash" && $live == "$usrhash" ]]; then
  echo "update-host: $target runs this image already"
  previous=
else
  echo "update-host: rebooting $target"
  ssh -n "$target" systemctl reboot || :
fi
# an unblessed boot reboots until systemd-boot falls back, up to three tries
patience=1200
deadline=$((SECONDS + patience)) seen=$previous
while :; do
  if ((SECONDS >= deadline)); then
    cat "$tmp/ssh" >&2
    fail "$target: no answer from a new boot for $((patience / 60)) minutes"
  fi
  if read -r id running _ assessment entry < <(ssh -n -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=10 \
    "$target" "$probe" 2>"$tmp/ssh") && [[ $id != "$previous" ]]; then
    [[ $running == "$usrhash" ]] || fail "$target rolled back to $entry"
    case $assessment in
    good | clean)
      echo "update-host: $target runs $entry, its boot is blessed"
      exit 0
      ;;
    esac
    [[ $id == "$seen" ]] || deadline=$((SECONDS + patience)) seen=$id
  fi
  # before the reboot, a connection shared through ControlMaster skipped this check
  if [[ $(<"$tmp/ssh") == *"Host key verification failed"* ]]; then
    cat "$tmp/ssh" >&2
    fail "$target answers, but ssh refuses its host key"
  fi
  sleep 10
done
